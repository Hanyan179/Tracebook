{
  "openapi": "3.1.1",
  "info": {
    "title": "Tracebook Read API",
    "version": "1.0.0",
    "description": "Scoped read-only access. Retrieval, not model generation. Default server is local; replace it with the user-authorized address."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "security": [
    {
      "readerBearer": []
    }
  ],
  "paths": {
    "/v1/assistant/query": {
      "post": {
        "operationId": "queryLibrary",
        "summary": "Retrieve excerpts from authorized personal sources",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired or revoked credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Operation or scope forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Content version changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assistant/search": {
      "post": {
        "operationId": "searchLibrary",
        "summary": "Retrieve excerpts from authorized personal sources",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired or revoked credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Operation or scope forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Content version changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assistant/capabilities": {
      "get": {
        "operationId": "libraryCapabilities",
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "version",
                    "mode",
                    "readOnly",
                    "scopes",
                    "limits"
                  ],
                  "properties": {
                    "version": {
                      "const": 1
                    },
                    "mode": {
                      "const": "retrieval"
                    },
                    "readOnly": {
                      "const": true
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "notes",
                          "transcripts",
                          "daily",
                          "confirmedMemory",
                          "analyses",
                          "localInputs",
                          "documents"
                        ]
                      }
                    },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "results": {
                          "const": 20
                        },
                        "charactersPerRead": {
                          "const": 16000
                        },
                        "requestsPerMinute": {
                          "const": 60
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired or revoked credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Operation or scope forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Content version changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assistant/items/{kind}/{id}": {
      "get": {
        "operationId": "readLibrarySource",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "note",
                "recording",
                "daily",
                "memory",
                "analysis",
                "input",
                "document"
              ]
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16000,
              "default": 8000
            }
          },
          {
            "in": "query",
            "name": "version",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Source"
                    },
                    {
                      "type": "object",
                      "required": [
                        "text",
                        "offset",
                        "totalCharacters",
                        "nextOffset"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "maxLength": 16000
                        },
                        "offset": {
                          "type": "integer"
                        },
                        "totalCharacters": {
                          "type": "integer"
                        },
                        "nextOffset": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired or revoked credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Operation or scope forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Source unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Content version changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "readerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped read credential issued in Tracebook External access. Never a device/admin token."
      }
    },
    "schemas": {
      "Source": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "date",
          "state",
          "textAvailable",
          "contentVersion",
          "uri"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "recording",
              "daily",
              "memory",
              "analysis",
              "input",
              "document"
            ]
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "state": {
            "type": "string"
          },
          "textAvailable": {
            "type": "boolean"
          },
          "contentVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": "string"
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "notes",
                "transcripts",
                "daily",
                "confirmedMemory",
                "analyses",
                "localInputs",
                "documents"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ]
          },
          "dateFrom": {
            "type": "string",
            "format": "date"
          },
          "dateTo": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "mode",
          "generatedAnswer",
          "trust",
          "sources",
          "coverage",
          "createdAt"
        ],
        "properties": {
          "mode": {
            "const": "retrieval"
          },
          "generatedAnswer": {
            "const": false
          },
          "trust": {
            "const": "source_data"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "sources": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Source"
                },
                {
                  "type": "object",
                  "required": [
                    "excerpt",
                    "excerptTruncated"
                  ],
                  "properties": {
                    "excerpt": {
                      "type": "string",
                      "maxLength": 1400
                    },
                    "excerptTruncated": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          },
          "coverage": {
            "type": "object",
            "required": [
              "scopes",
              "dateFrom",
              "dateTo",
              "eligibleItems",
              "returned",
              "hasMore",
              "indexRefreshSeconds"
            ],
            "properties": {
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "notes",
                    "transcripts",
                    "daily",
                    "confirmedMemory",
                    "analyses",
                    "localInputs",
                    "documents"
                  ]
                }
              },
              "dateFrom": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "dateTo": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "eligibleItems": {
                "type": "integer"
              },
              "returned": {
                "type": "integer"
              },
              "hasMore": {
                "type": "boolean"
              },
              "indexRefreshSeconds": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
